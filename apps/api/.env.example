NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/beauty_store
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=changeme
WEB_ORIGIN=http://localhost:3000
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=changeme-32-chars-minimum-please
BETTER_AUTH_URL=http://localhost:3001

# Sprint 12B.11: optional. Set this to your isolated beauty_store_test
# connection string and the `import:legacy:catalog-workflow` CLI's write mode
# (and its read-only analysis, so its preview reflects the same database a
# matching write will target) always use it automatically - no manual
# DATABASE_URL override needed in your shell. DATABASE_URL above can stay
# pointed at your regular beauty_store_dev for everything else the app does.
# CATALOG_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/beauty_store_test

# Cloudflare R2 (S3-compatible) - optional. Leave unset and the app boots
# fine; media upload endpoints return a 503 media_not_configured instead.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://media.example.com
