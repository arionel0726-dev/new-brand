NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/beauty_store
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=changeme
WEB_ORIGIN=http://localhost:3000
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=changeme-32-chars-minimum-please
BETTER_AUTH_URL=http://localhost:3001

# Cloudflare R2 (S3-compatible) - optional. Leave unset and the app boots
# fine; media upload endpoints return a 503 media_not_configured instead.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://media.example.com
